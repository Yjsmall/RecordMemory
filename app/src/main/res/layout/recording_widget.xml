<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="随声记" android:textColor="#20382A" android:textSize="14sp" android:gravity="center" android:maxLines="2" />
    <TextView android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="48dp" android:gravity="center" android:text="开始录音" android:textStyle="bold" android:textColor="#20382A" android:textSize="16sp" />
    <TextView android:id="@+id/widget_pause" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center" android:text="暂停" android:textColor="#20382A" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
